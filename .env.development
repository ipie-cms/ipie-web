VITE_USER_SERVICE_BASE_URL=http://localhost:8092
VITE_IAM_SERVICE_BASE_URL=http://localhost:8093
VITE_COMMUNICATION_SERVICE_BASE_URL=http://localhost:8094
VITE_KEYCLOAK_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ipie
VITE_KEYCLOAK_CLIENT_ID=ipie-service-template
VITE_KEYCLOAK_CLIENT_SECRET=ipie-service-template-secret
# Public, PKCE-only client for the stakeholder-SSO login path ("Login with IBBI") - identity
# brokering needs the OIDC Authorization Code flow, which the ROPC client above doesn't support.
VITE_KEYCLOAK_SSO_CLIENT_ID=ipie-web-sso
